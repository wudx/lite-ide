{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiteIDE",
  "version": "0.1.0",
  "identifier": "com.liteide.app",
  "build": {
    "beforeDevCommand": "pnpm build:plugins && pnpm --filter @lite-ide/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:plugins && pnpm --filter @lite-ide/desktop build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LiteIDE",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
