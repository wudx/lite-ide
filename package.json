{
  "name": "lite-ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:plugins && pnpm --filter @lite-ide/desktop dev",
    "build": "pnpm build:plugins && pnpm --filter @lite-ide/desktop build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:plugins": "pnpm --parallel --filter @lite-ide/plugin-theme-nord --filter @lite-ide/plugin-preview-fallback --filter @lite-ide/plugin-preview-image --filter @lite-ide/plugin-preview-audio --filter @lite-ide/plugin-preview-markdown --filter @lite-ide/plugin-preview-code --filter @lite-ide/plugin-explorer --filter @lite-ide/plugin-git --filter @lite-ide/plugin-terminal --filter @lite-ide/sample-plugin-bundle-notes run build:plugin",
    "watch:plugins": "pnpm --parallel --filter @lite-ide/plugin-theme-nord --filter @lite-ide/plugin-preview-fallback --filter @lite-ide/plugin-preview-image --filter @lite-ide/plugin-preview-audio --filter @lite-ide/plugin-preview-markdown --filter @lite-ide/plugin-preview-code --filter @lite-ide/plugin-explorer --filter @lite-ide/plugin-git --filter @lite-ide/plugin-terminal --filter @lite-ide/sample-plugin-bundle-notes run watch:plugin"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.15.0",
    "jsdom": "^26.1.0",
    "solid-js": "^1.9.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
